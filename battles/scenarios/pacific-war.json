  "phases": [
    {
      "id": "p1",
      "title": "The Second Sino-Japanese War",
      "time": "July 1937 – 1941",
      "durationSec": 12,
      "narration": "A clash at the Marco Polo Bridge near Beijing on 7 July 1937 becomes full-scale war. Japan wins a long, bloody battle for Shanghai and takes Nanjing in December, where its troops massacre an estimated 200,000–300,000 civilians and prisoners. Wuhan falls in 1938, and Chiang Kai-shek's government moves up the Yangtze to Chongqing. The war settles into a stalemate in which the Japanese hold the cities and railways and cannot end the war.",
