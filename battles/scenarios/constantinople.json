  "result": {
    "summary": "The Ottomans took the city on 29 May 1453 after 53 days, ending the Byzantine Empire. Western accounts give inflated Ottoman numbers (160,000-300,000); modern estimates are 50,000-80,000 against 7,000-8,000 defenders. The walls, which had resisted sieges for a thousand years, were worn down by gunpowder artillery and finally stormed in a three-wave night assault after Giustiniani was wounded.",
    "casualties": {
      "A": "Unknown but heavy; likely several thousand dead over the siege",
      "B": "~4,000 killed (Nicolle); ~30,000 enslaved (Crowley); Emperor Constantine XI killed"
    }
  },
