  "phases": [
    {
      "id": "p1",
      "title": "Deployment on the levelled plain",
      "time": "dawn, 1 October 331 BCE",
      "durationSec": 8,
      "narration": "Darius had had the ground levelled and the Persian host stands drawn up in the open: Bessus's Bactrians and Scythians on the left, Darius with his Kinsmen, Greeks and Immortals in the centre, Mazaeus on the right. Alexander, vastly outnumbered in cavalry, forms a double-fronted oblong with flank guards angled back and a reserve line facing the rear.",
      "orders": [
        {
          "unit": "mac-phalanx",
          "action": "hold"
        },
        {
          "unit": "per-darius-guard",
          "action": "hold"
        }
      ],
      "outcomes": []
    },
    {
      "id": "p2",
      "title": "Oblique advance to the right",
      "time": "morning",
      "durationSec": 10,
      "narration": "Alexander leads the army forward and edges steadily to the right, towards ground the Persians had not levelled. Bessus and the Scythians shadow the movement to prevent being outflanked, stretching the Persian left away from the centre.",
