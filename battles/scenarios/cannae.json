  "result": {
    "summary": "Rome suffered the worst single-day defeat in its history. Capua, Tarentum and much of southern Italy defected to Hannibal, yet Rome refused terms, raised new legions and, avoiding pitched battle, eventually carried the war to Africa.",
    "casualties": {
      "A": "~5,700–8,000 killed (Polybius ~5,700 incl. ~4,000 Celts; Livy ~8,000)",
      "B": "~48,000 killed (Livy) to ~70,000 killed (Polybius); 10,000–19,000 captured"
    }
  },
